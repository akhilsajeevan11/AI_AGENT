# OpenAI API Key (replace with your actual key if using OpenAI)
# OPENAI_API_KEY="your_openai_api_key_here"

# Groq API Key (replace with your actual key if using Groq)
# GROQ_API_KEY="your_groq_api_key_here"

# Other LLM provider API keys can be added here as needed.

# You can also specify the model name if you want to override defaults.
# For OpenAI, models like "gpt-4", "gpt-3.5-turbo" are common.
# For Groq, models like "mixtral-8x7b-32768", "llama2-70b-4096" are common.
# OPENAI_MODEL_NAME="gpt-4"
# GROQ_MODEL_NAME="mixtral-8x7b-32768"
# LANGCHAIN_API_KEY="your_langchain_smith_api_key_here" # For LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2="true" # To enable LangSmith tracing (optional)
