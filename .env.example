# LLM Provider Selection (optional, defaults to "openai" if not set)
# Valid values: "openai", "groq", "gemini"
# LLM_PROVIDER="openai"

# -----------------------------------------
# OpenAI Configuration
# -----------------------------------------
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_MODEL_NAME="gpt-4" # Or "gpt-3.5-turbo", "gpt-4-turbo-preview", etc.

# -----------------------------------------
# Groq Configuration (Example)
# -----------------------------------------
# Uncomment and set if using Groq:
# LLM_PROVIDER="groq"
# GROQ_API_KEY="your_groq_api_key_here"
# GROQ_MODEL_NAME="mixtral-8x7b-32768" # Or "llama2-70b-4096", etc.

# -----------------------------------------
# Google Gemini Configuration (Example)
# -----------------------------------------
# Uncomment and set if using Google Gemini:
# LLM_PROVIDER="gemini"
# GOOGLE_API_KEY="your_google_api_key_here"
# GOOGLE_GEMINI_MODEL_NAME="gemini-1.5-pro-latest" # Or "gemini-1.5-flash-latest", "gemini-pro" etc.

# -----------------------------------------
# LangSmith Tracing (Optional)
# For observability and debugging Langchain/CrewAI applications
# -----------------------------------------
# LANGCHAIN_API_KEY="your_langchain_smith_api_key_here"
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_PROJECT="Your_Project_Name" # Optional: organize runs into projects
